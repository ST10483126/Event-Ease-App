@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-4">
    <div class="card border-0 shadow-sm p-4 bg-white">
        <h1 class="text-primary fw-bold mb-3">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">Last updated: May 2026</p>

        <div class="row">
            <div class="col-md-9">
                <section class="mb-4">
                    <h4 class="text-secondary fw-bold">1. Information We Collect</h4>
                    <p class="text-dark">
                        EventEase collects standard system parameters required to manage venue bookings and coordinate event hosting accounts. This includes customer names, contact numbers, email details, and scheduling selections entered during form submissions.
                    </p>
                </section>

                <section class="mb-4">
                    <h4 class="text-secondary fw-bold">2. How We Use Data</h4>
                    <p class="text-dark">
                        Your data is processed strictly to maintain database transactional integrity. This guarantees venue double-booking preventative logic resolves accurately on the cloud servers and ensures administrative event management scripts run efficiently.
                    </p>
                </section>

                <section class="mb-4">
                    <h4 class="text-secondary fw-bold">3. Cloud Storage Security</h4>
                    <p class="text-dark">
                        All uploaded location media components and transactional files are safely stored inside encrypted cloud environments (including Azure SQL and Azure Blob Storage containers). We do not distribute or open collected metrics to external third-party tracking frameworks.
                    </p>
                </section>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top border-light">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Return Home</a>
        </div>
    </div>
</div>
