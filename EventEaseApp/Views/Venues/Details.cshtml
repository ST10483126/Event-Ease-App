@model EventEaseApp.Models.Venue

@{
    ViewData["Title"] = "Details";
}

<div class="container my-4">
    <div class="card border-0 shadow-sm p-4 bg-white">
        <h1 class="text-primary fw-bold mb-4">Venue Details</h1>

        <div class="row g-4">
            <!-- Information Column -->
            <div class="col-md-7">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Venuename)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.Venuename)
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Address)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.Address)
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Capacity)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.Capacity)
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Location)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.Location)
                    </dd>
                </dl>
            </div>

            <!-- Image Column -->
            <div class="col-md-5 text-center text-md-start">
                <label class="form-label fw-bold text-secondary mb-2">Venue Preview Image</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm border border-light" style="max-width: 100%; max-height: 300px; object-fit: contain;" alt="Venue Image" />
                    }
                    else
                    {
                        <div class="bg-light text-muted border rounded shadow-sm text-center d-flex align-items-center justify-content-center mx-auto mx-md-0" style="width: 100%; max-width: 300px; height: 200px; font-size: 0.88rem;">
                            No Image Available
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Management Links Row -->
        <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top border-light">
            <a asp-action="Edit" asp-route-id="@Model?.Venueid" class="btn btn-primary px-4 shadow-sm">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
        </div>
    </div>
</div>
