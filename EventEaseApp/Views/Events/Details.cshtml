@model EventEaseApp.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container my-4">
    <div class="card border-0 shadow-sm p-4 bg-white">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="text-primary fw-bold mb-0">Event Details</h1>
                <p class="page-subtitle mt-1">View complete event information</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.EventId" class="btn btn-primary px-4 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <dl class="row mb-0">
                    <!-- Event Name -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.EventName)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        <strong>@Html.DisplayFor(model => model.EventName)</strong>
                    </dd>

                    <!-- Event Type -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        Event Type
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @if (Model.EventType != null)
                        {
                            <span class="badge bg-info text-white px-3 py-2">@Model.EventType.EventTypeName</span>
                        }
                        else
                        {
                            <span class="text-muted">— Not specified —</span>
                        }
                    </dd>

                    <!-- Event Description -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.EventDescription)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.EventDescription)
                    </dd>

                    <!-- Start Date & Time -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        Start Date & Time
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="me-2 text-primary">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span>@Model.EventTime.ToString("dddd, dd MMMM yyyy")</span>
                        </div>
                        <div class="mt-1 ms-4 text-muted small">@Model.EventTime.ToString("HH:mm")</div>
                    </dd>

                    <!-- End Date & Time -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        End Date & Time
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @if (Model.EventEndTime.HasValue)
                        {
                            <div class="d-flex align-items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="me-2 text-primary">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span>@Model.EventEndTime.Value.ToString("dddd, dd MMMM yyyy")</span>
                            </div>
                            <div class="mt-1 ms-4 text-muted small">@Model.EventEndTime.Value.ToString("HH:mm")</div>
                        }
                        else
                        {
                            <span class="text-muted">— Not specified —</span>
                        }
                    </dd>

                    <!-- Location -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Location)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="me-2 text-danger">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>@Html.DisplayFor(model => model.Location)</span>
                        </div>
                    </dd>

                    <!-- Status -->
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Status)
                    </dt>
                    <dd class="col-sm-9 mb-3">
                        @{
                            var statusClass = Model.Status?.ToLower() switch
                            {
                                "scheduled" => "badge bg-info text-white px-3 py-2",
                                "ongoing" => "badge bg-warning text-dark px-3 py-2",
                                "completed" => "badge bg-success text-white px-3 py-2",
                                "cancelled" => "badge bg-danger text-white px-3 py-2",
                                _ => "badge bg-secondary text-white px-3 py-2"
                            };
                        }
                        <span class="@statusClass" style="border-radius: 20px;">@Model.Status</span>
                    </dd>
                </dl>
            </div>

            <!-- Summary Card on the Right -->
            <div class="col-md-4">
                <div class="border rounded-3 p-3 bg-light">
                    <h5 class="fw-bold text-primary mb-3">Event Summary</h5>
                    <div class="mb-3">
                        <div class="text-center mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="text-primary">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div class="small text-muted">
                            <div><strong>Event Name:</strong> @Model.EventName</div>
                            <div><strong>Date:</strong> @Model.EventTime.ToString("dd MMM yyyy")</div>
                            <div><strong>Time:</strong> @Model.EventTime.ToString("HH:mm")</div>
                            <div><strong>Location:</strong> @Model.Location</div>
                            <div><strong>Status:</strong> @Model.Status</div>
                        </div>
                    </div>
                    <div class="text-center mt-3 pt-2 border-top">
                        <a asp-controller="Bookings" asp-action="Create" class="btn btn-success btn-sm w-100">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            Create Booking for this Event
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-subtitle {
        color: #6b7280;
        font-size: 0.9rem;
        margin: 0;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        transition: transform 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #7b8eed 0%, #8b5db5 100%);
    }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
    }

    .btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .badge {
        font-size: 0.8rem;
        font-weight: 600;
    }

    dl dt {
        font-size: 0.85rem;
    }

    dl dd {
        font-size: 0.95rem;
    }
</style>