@model EventEaseApp.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container my-4">
    <div class="card border-0 shadow-sm p-4 bg-white">
        <h1 class="text-danger fw-bold mb-4">Delete Event</h1>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="alert alert-warning">
            <strong>Warning!</strong> Are you sure you want to delete this event? This action cannot be undone.
        </div>

        <div class="row">
            <div class="col-md-8">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.EventName)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.EventName)
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.EventDescription)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.EventDescription)
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.EventTime)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Model.EventTime.ToString("dd MMM yyyy, HH:mm")
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.EventEndTime)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @(Model.EventEndTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not specified")
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Location)
                    </dt>
                    <dd class="col-sm-9 text-dark mb-3">
                        @Html.DisplayFor(model => model.Location)
                    </dd>

                    <dt class="col-sm-3 text-secondary fw-bold mb-3">
                        @Html.DisplayNameFor(model => model.Status)
                    </dt>
                    <dd class="col-sm-9 mb-3">
                        @{
                            var statusClass = Model.Status?.ToLower() switch
                            {
                                "scheduled" => "badge bg-info text-white",
                                "ongoing" => "badge bg-warning text-dark",
                                "completed" => "badge bg-success text-white",
                                "cancelled" => "badge bg-danger text-white",
                                _ => "badge bg-secondary text-white"
                            };
                        }
                        <span class="@statusClass px-3 py-2" style="border-radius: 20px;">@Model.Status</span>
                    </dd>
                </dl>
            </div>
            <div class="col-md-4 text-center">
                <div class="border rounded p-3 bg-light">
                    <label class="fw-bold text-secondary mb-2">Event Summary</label>
                    <div class="mt-3">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="text-primary">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <p class="mt-2 mb-0 text-muted">Event Details</p>
                        </div>
                        <div class="small text-muted">
                            <div><strong>Date:</strong> @Model.EventTime.ToString("dd MMM yyyy")</div>
                            <div><strong>Time:</strong> @Model.EventTime.ToString("HH:mm")</div>
                            <div><strong>Location:</strong> @Model.Location</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Actions Panel -->
        <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="EventId" />
                <button type="submit" class="btn btn-danger px-4 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </form>
        </div>
    </div>
</div>

<style>
    .alert-warning {
        background-color: #fff3cd;
        border-color: #ffeeba;
        color: #856404;
        border-radius: 10px;
    }

    .alert-danger {
        border-radius: 10px;
    }

    .card {
        border-radius: 16px;
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        border: none;
        transition: transform 0.2s ease;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
    }

    .badge {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 12px;
    }
</style>