@model EventEaseApp.Models.Event

@{
    ViewData["Title"] = "Edit";
}

<div class="container my-4">
    <div class="card border-0 shadow-sm p-4 bg-white">
        <h1 class="text-primary fw-bold mb-4">Edit Event</h1>
        
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EventId" />
            
            <!-- Event Name -->
            <div class="mb-3">
                <label asp-for="EventName" class="form-label fw-bold text-secondary"></label>
                <input asp-for="EventName" class="form-control shadow-sm" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            
            <!-- Event Type Dropdown -->
            <div class="mb-3">
                <label asp-for="EventTypeId" class="form-label fw-bold text-secondary">Event Type</label>
                <select asp-for="EventTypeId" class="form-select shadow-sm" asp-items="ViewBag.EventTypes">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="EventTypeId" class="text-danger"></span>
            </div>

            <!-- Event Description -->
            <div class="mb-3">
                <label asp-for="EventDescription" class="form-label fw-bold text-secondary"></label>
                <textarea asp-for="EventDescription" class="form-control shadow-sm" rows="3"></textarea>
                <span asp-validation-for="EventDescription" class="text-danger"></span>
            </div>

            <!-- Event Start Time -->
            <div class="mb-3">
                <label asp-for="EventTime" class="form-label fw-bold text-secondary"></label>
                <input asp-for="EventTime" class="form-control shadow-sm" type="datetime-local" />
                <span asp-validation-for="EventTime" class="text-danger"></span>
            </div>

            <!-- Event End Time -->
            <div class="mb-3">
                <label asp-for="EventEndTime" class="form-label fw-bold text-secondary"></label>
                <input asp-for="EventEndTime" class="form-control shadow-sm" type="datetime-local" />
                <span asp-validation-for="EventEndTime" class="text-danger"></span>
            </div>

            <!-- Location -->
            <div class="mb-3">
                <label asp-for="Location" class="form-label fw-bold text-secondary"></label>
                <input asp-for="Location" class="form-control shadow-sm" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <!-- Status -->
            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-bold text-secondary"></label>
                <select asp-for="Status" class="form-select shadow-sm">
                    <option value="">-- Select Status --</option>
                    <option value="Scheduled">Scheduled</option>
                    <option value="Ongoing">Ongoing</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <!-- Form Submissions Actions -->
            <div class="d-flex align-items-center gap-3 mt-4">
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
